# ==============================================================================
# MODELO DE CONFIGURAÇÃO — NÃO EDITE ESTE ARQUIVO COM DADOS REAIS
# ------------------------------------------------------------------------------
# 1. Crie uma cópia chamada .env:
#      Windows (PowerShell): Copy-Item backend/.env.example backend/.env
#      Linux/macOS:          cp backend/.env.example backend/.env
# 2. Preencha as credenciais no arquivo .env (que é ignorado pelo Git).
# 3. Reinicie o servidor Django: as variáveis só são lidas na inicialização.
# Este arquivo (.env.example) é versionado e não deve conter segredos.
# ==============================================================================

# Configurações do Django
DJANGO_SECRET_KEY=troque-esta-chave-em-producao
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==============================================================================
# CONFIGURAÇÃO DO MOTOR DE IA (LLM Gateway Desacoplado)
# ==============================================================================
# Opções de LLM_PROVIDER:
#   - litellm           -> Usa o LiteLLM (suporta Gemini, OpenAI, Claude, DeepSeek, Ollama ou LiteLLM Proxy)
#   - openai_compatible -> Usa o cliente OpenAI direto (para LiteLLM Proxy, DeepSeek API direta ou Ollama local)

# --- Opção A: LiteLLM direto (ex.: Gemini, DeepSeek, OpenAI, Claude) ---
LLM_PROVIDER=litellm
LLM_MODEL=gemini/gemini-2.0-flash
LLM_API_KEY=sua_chave_aqui
LLM_BASE_URL=
LLM_TIMEOUT=60

# --- Opção B: LiteLLM Proxy (gerenciamento de chaves e custos da equipe) ---
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:4000/v1
# LLM_MODEL=fluxoia-default
# LLM_API_KEY=sk-chave-virtual-do-desenvolvedor

# --- Opção C: API DeepSeek direta (sem LiteLLM) ---
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-sua-chave-deepseek

# --- Opção D: LLM Local na UFPI/SECTI (Ollama / vLLM) ---
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=ollama
