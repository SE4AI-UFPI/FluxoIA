# Copie para .env e ajuste antes de subir: cp .env.example .env

# Porta pública da aplicação (80 em VPS, 8080 se a 80 estiver ocupada localmente)
APP_PORT=80

# Obrigatório. Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

DJANGO_DEBUG=False
# Inclua o domínio ou IP da VPS, separados por vírgula. Ex.: fluxoia.exemplo.com.br,203.0.113.10
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# Banco PostgreSQL (roda no compose). Obrigatório definir a senha.
# Use só caracteres seguros em URL (token_urlsafe serve): ela entra na DATABASE_URL do LiteLLM.
POSTGRES_DB=fluxoia
POSTGRES_USER=fluxoia
POSTGRES_PASSWORD=

# LiteLLM Proxy. Obrigatórios.
# Master key: precisa começar com "sk-". Ex.: python3 -c "import secrets; print('sk-' + secrets.token_urlsafe(32))"
# Também é a senha da UI (http://localhost:${LITELLM_UI_PORT}/ui, usuário admin).
LITELLM_MASTER_KEY=
# Salt key: criptografa as credenciais salvas no banco. NUNCA troque depois de definida.
LITELLM_SALT_KEY=

# Porta da UI do LiteLLM, publicada só em 127.0.0.1 (troque se a 4000 estiver ocupada).
LITELLM_UI_PORT=4000

# Virtual key do backend, gerada no LiteLLM depois do primeiro "up" (veja o README).
LLM_API_KEY=

# Servidor de LLM por trás do LiteLLM (Ollama / vLLM). Dentro do container, localhost
# não aponta para o host: use host.docker.internal.
LLM_UPSTREAM_BASE_URL=http://host.docker.internal:11434/v1
LLM_UPSTREAM_API_KEY=ollama
